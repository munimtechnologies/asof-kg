# Which version of a topic was in force on ?on, using only what was
# published by ?knownAt? Set ?knownAt = ?on for "what a clinician could know
# that day", or a later date for an audit. Versions published after ?knownAt
# are invisible, so the answer never uses hindsight.
PREFIX akg: <https://github.com/munimtechnologies/asof-kg/ontology#>
PREFIX akgd: <https://github.com/munimtechnologies/asof-kg/data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?version ?published WHERE {
  VALUES (?topic ?on ?knownAt) {
    (akgd:colorectal-cancer-screening "2019-03-01"^^xsd:date "2019-03-01"^^xsd:date)
  }
  ?version akg:topic ?topic ;
           akg:publishedOn ?published .
  FILTER (?published <= ?on && ?published <= ?knownAt)
  FILTER NOT EXISTS {
    ?newer akg:supersedes ?version ;
           akg:publishedOn ?q .
    FILTER (?q <= ?on && ?q <= ?knownAt)
  }
}
